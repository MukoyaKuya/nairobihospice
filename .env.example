# Nairobi Hospice PCMS - Environment Configuration (Production / Staging Ready)
DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-chars-for-nairobi-hospice
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=nairobihospice.or.ke,www.nairobihospice.or.ke,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://nairobihospice.or.ke,https://www.nairobihospice.or.ke

# Database Configuration (PostgreSQL 14+ or MySQL 8.0.16+ with CHECK support)
DB_ENGINE=postgresql
DB_NAME=nairobih_pcms
DB_USER=nairobih_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Cache & Celery Asynchronous Workers
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Security, SSL & Session Hardening
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
MFA_REQUIRED_FOR_PRIVILEGED=True
MFA_REQUIRED_FOR_ALL_STAFF=True
SESSION_COOKIE_AGE=1800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Malware Defense (Fail-closed in production)
PCMS_REQUIRE_MALWARE_SCAN=True
PCMS_MALWARE_SCANNER_COMMAND=clamscan

# Monitoring & Error Reporting
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# SMTP Email Configuration (Webmail / Transactional)
EMAIL_HOST=mail.nairobihospice.or.ke
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@nairobihospice.or.ke
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=Nairobi Hospice <noreply@nairobihospice.or.ke>
